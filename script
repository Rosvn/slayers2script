-- MODULE 2: NAVIGATION, MOVEMENT & PHYSICS TESTING SERVICE
-- ============================================================================
Modules.MovementAndNav = (function()
	local MovementAndNav = {}
	MovementAndNav.__index = MovementAndNav

	local WAYPOINTS: { [string]: Vector3 } = {
		["StarterVillage"] = Vector3.new(120, 45, -310),
		["FinalSelection"] = Vector3.new(-1420, 210, 890),
		["ButterflyMansion"] = Vector3.new(640, 52, 1120),
		["TowerEntrance"] = Vector3.new(2100, 185, -450),
		["SpiderLily_1"] = Vector3.new(-412, 38, 1205),
		["SpiderLily_2"] = Vector3.new(1890, 95, -1420),
		["SpiderLily_3"] = Vector3.new(-2150, 140, -610),
	}

	function MovementAndNav.new(config: any, eventBus: any)
		local self = setmetatable({}, MovementAndNav)
		self._config = config
		self._bus = eventBus
		self._player = Players.LocalPlayer
		self._positionHistory = {} :: { CFrame }
		self._savedCFrame = nil :: CFrame?
		self._lastSafePosition = Vector3.new(0, 50, 0)
		self._flightVelocity = nil :: LinearVelocity?
		self._flightAttachment = nil :: Attachment?

		self:_initLoops()
		return self
	end

	function MovementAndNav:_getCharacter(): (Model?, Humanoid?, BasePart?)
		local char = self._player.Character
		if not char then return nil, nil, nil end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		return char, hum, root
	end

	function MovementAndNav:NavigateTo(targetPos: Vector3): boolean
		local char, hum, root = self:_getCharacter()
		if not char or not hum or not root then return false end

		local path = PathfindingService:CreatePath({
			AgentRadius = 2.5,
			AgentHeight = 5.5,
			AgentCanJump = true,
			AgentCanClimb = true,
			WaypointSpacing = 8,
		})

		local success, _ = pcall(function()
			path:ComputeAsync(root.Position, targetPos)
		end)

		if not success or path.Status ~= Enum.PathStatus.Success then
			hum:MoveTo(targetPos)
			return false
		end

		local waypoints = path:GetWaypoints()
		for i = 2, #waypoints do
			local wp = waypoints[i]
			if wp.Action == Enum.PathWaypointAction.Jump then
				hum.Jump = true
			end
			hum:MoveTo(wp.Position)
			local reached = hum.MoveToFinished:Wait()
			if not reached then
				hum.Jump = true
				return false
			end
		end
		return true
	end

	function MovementAndNav:GetWaypoints(): { [string]: Vector3 }
		return WAYPOINTS
	end

	function MovementAndNav:_updateFlight(root: BasePart, enabled: boolean)
		if not enabled then
			if self._flightVelocity then self._flightVelocity:Destroy(); self._flightVelocity = nil end
			if self._flightAttachment then self._flightAttachment:Destroy(); self._flightAttachment = nil end
			return
		end

		if not self._flightAttachment then
			local att = Instance.new("Attachment")
			att.Name = "DevFlightAttachment"
			att.Parent = root
			self._flightAttachment = att

			local lv = Instance.new("LinearVelocity")
			lv.Attachment0 = att
			lv.MaxForce = 1e6
			lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
			lv.Parent = root
			self._flightVelocity = lv
		end

		local cam = workspace.CurrentCamera
		if not cam or not self._flightVelocity then return end

		local moveDir = Vector3.zero
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir += cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir -= cam.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir += cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir -= cam.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir += Vector3.yAxis end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir -= Vector3.yAxis end

		local speed = self._config:Get("FlightSpeed") or 60
		self._flightVelocity.VectorVelocity = if moveDir.Magnitude > 0 then moveDir.Unit * speed else Vector3.zero
	end

	function MovementAndNav:_initLoops()
		RunService.Stepped:Connect(function()
			local char, hum, root = self:_getCharacter()
			if not char or not hum or not root then return end

			if self._config:Get("NoClipEnabled") then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end

			if self._config:Get("AntiFlingEnabled") then
				if root.AssemblyAngularVelocity.Magnitude > 50 then
					root.AssemblyAngularVelocity = Vector3.zero
				end
				if root.AssemblyLinearVelocity.Magnitude > 250 and not self._config:Get("FlightEnabled") then
					root.AssemblyLinearVelocity = root.AssemblyLinearVelocity.Unit * 100
				end
			end

			if self._config:Get("AntiVoidEnabled") then
				if root.Position.Y < (workspace.FallenPartsDestroyHeight + 65) then
					root.AssemblyLinearVelocity = Vector3.zero
					root.CFrame = CFrame.new(self._lastSafePosition + Vector3.new(0, 5, 0))
				elseif hum.FloorMaterial ~= Enum.Material.Air then
					self._lastSafePosition = root.Position
				end
			end
		end)

		local historyTimer = 0
		RunService.Heartbeat:Connect(function(dt)
			local _, hum, root = self:_getCharacter()
			if not hum or not root then return end

			hum.WalkSpeed = self._config:Get("WalkSpeed")
			hum.JumpPower = self._config:Get("JumpPower")
			self:_updateFlight(root, self._config:Get("FlightEnabled"))

			historyTimer += dt
			if historyTimer >= 0.2 then
				historyTimer = 0
				table.insert(self._positionHistory, root.CFrame)
				if #self._positionHistory > 150 then
					table.remove(self._positionHistory, 1)
				end
			end
		end)
	end

	return MovementAndNav
end)()

