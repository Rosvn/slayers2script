			end

			btn.MouseButton1Click:Connect(function()
				local current = self._config:Get(item.Key)
				self._config:Set(item.Key, not current)
				refreshText()
			end)

			refreshText()
			btn.Parent = scroll
		end

		self._bus:Subscribe("ActiveTaskChanged", function(taskName: string)
			statusBanner.Text = string.format(" [ACTIVE STATE]: %s", taskName)
		end)
	end

	return DashboardUI
end)()

