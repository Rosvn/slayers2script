local bus = Modules.Core.EventBus.new()
local config = Modules.Core.ConfigManager.new(bus)
local arbiter = Modules.Core.StateArbiter.new(bus)
local adapter = Modules.Core.DefaultGameAdapter

local nav = Modules.MovementAndNav.new(config, bus)
local combat = Modules.CombatService.new(config, bus, adapter, nav)
local _ui = Modules.DashboardUI.new(config, bus, arbiter, adapter)

arbiter:RegisterTask({
	Name = "SURVIVAL_RETREAT",
	Priority = 100,
	Status = "IDLE",
	Condition = function()
		return config:Get("CombatEnabled") and combat:EvaluateSurvival()
	end,
	Execute = function(_dt: number) end,
})

arbiter:RegisterTask({
	Name = "COMBAT_ENGAGEMENT",
	Priority = 80,
	Status = "IDLE",
	Condition = function()
		if not config:Get("CombatEnabled") and not config:Get("AutoMobFarm") then
			return false
		end
		return combat:FindBestTarget(150) ~= nil
	end,
	Execute = function(_dt: number)
		local target = combat:FindBestTarget(150)
		if target then
			combat:EngageTarget(target)
		end
	end,
})

RunService.Heartbeat:Connect(function(dt: number)
	arbiter:Step(dt)
end)
