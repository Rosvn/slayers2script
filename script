Modules.DomainModules = (function()
	local TowerModule = {}
	TowerModule.__index = TowerModule

	local CARD_WEIGHT_PATTERNS = {
		{ Pattern = "Lifesteal", Weight = 100 },
		{ Pattern = "Damage_Boost_III", Weight = 95 },
		{ Pattern = "Crit_Multiplier", Weight = 90 },
		{ Pattern = "Boss_Slayer", Weight = 88 },
		{ Pattern = "Cooldown_Reduction", Weight = 85 },
		{ Pattern = "Breathing_Mastery", Weight = 82 },
		{ Pattern = "Demon_Art_Amplify", Weight = 80 },
		{ Pattern = "Attack_Speed", Weight = 75 },
		{ Pattern = "Health_Regen", Weight = 70 },
		{ Pattern = "Defense_Up", Weight = 65 },
		{ Pattern = "Stamina_Surge", Weight = 60 },
		{ Pattern = "Curse_GlassCannon", Weight = -50 },
		{ Pattern = "Enemy_Haste", Weight = -80 },
	}

	function TowerModule.new(adapter: any, eventBus: any)
		local self = setmetatable({}, TowerModule)
		self._adapter = adapter
		self._bus = eventBus
		self.CardsSelected = 0
		return self
	end

	function TowerModule:ScoreCard(cardId: string): number
		local score = 50
		for _, rule in ipairs(CARD_WEIGHT_PATTERNS) do
			if string.find(string.lower(cardId), string.lower(rule.Pattern)) then
				score += rule.Weight
			end
		end
		return score
	end

	function TowerModule:PickBestCard(offeredCards: { string }): string?
		local bestCard: string? = nil
		local highestScore = -math.huge
		for _, cardId in ipairs(offeredCards) do
			local score = self:ScoreCard(cardId)
			if score > highestScore then
				highestScore = score
				bestCard = cardId
			end
		end
		if bestCard and self._adapter.SelectTowerCard(bestCard) then
			self.CardsSelected += 1
		end
		return bestCard
	end

	return {
		TowerModule = TowerModule,
	}
end)()

