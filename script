Modules.CombatService = (function()
	local CombatService = {}
	CombatService.__index = CombatService

	function CombatService.new(config: any, eventBus: any, adapter: any, navService: any)
		local self = setmetatable({}, CombatService)
		self._config = config
		self._bus = eventBus
		self._adapter = adapter
		self._nav = navService
		self._player = Players.LocalPlayer
		self._comboIndex = 1
		self._lastAttackClock = 0

		self.Stats = {
			TotalHitsVerified = 0,
			TargetsDefeated = 0,
			DamageDealtEstimate = 0,
			ParriesExecuted = 0,
		}
		return self
	end

	function CombatService:FindBestTarget(maxRadius: number): Model?
		local char = self._player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then return nil end

		local npcFolder = self._adapter.GetNPCFolder()
		if not npcFolder then return nil end

		local priorities: { string } = self._config:Get("TargetPriority")
		local bestTarget: Model? = nil
		local bestScore = -math.huge

		for _, candidate in ipairs(npcFolder:GetChildren()) do
			if candidate:IsA("Model") then
				local hum = candidate:FindFirstChildOfClass("Humanoid")
				local npcRoot = candidate:FindFirstChild("HumanoidRootPart") :: BasePart?
				if hum and npcRoot and hum.Health > 0 then
					local dist = (npcRoot.Position - root.Position).Magnitude
					if dist <= maxRadius then
						local priorityWeight = 1
						for idx, keyword in ipairs(priorities) do
							if string.find(string.lower(candidate.Name), string.lower(keyword)) then
								priorityWeight = (#priorities - idx + 2) * 1000
								break
							end
						end
						local score = priorityWeight - dist
						if score > bestScore then
							bestScore = score
							bestTarget = candidate
						end
					end
				end
			end
		end

		return bestTarget
	end

	function CombatService:EvaluateSurvival(): boolean
		local char = self._player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not hum or not root or hum.MaxHealth <= 0 then return false end

		local healthPct = hum.Health / hum.MaxHealth
		if healthPct <= self._config:Get("RetreatHealthPct") then
			local target = self:FindBestTarget(60)
			if target and target.PrimaryPart then
				local awayDir = (root.Position - target.PrimaryPart.Position).Unit
				hum:MoveTo(root.Position + (awayDir * 35))
			end
			if healthPct <= self._config:Get("HealHealthPct") then
				self._adapter.UseHealingItem("Bandage")
			end
			return true
		end
		return false
	end

	function CombatService:EngageTarget(target: Model)
		local char = self._player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		local targetHum = target:FindFirstChildOfClass("Humanoid")
		local targetRoot = target:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root or not targetHum or not targetRoot then return end

		local desiredDist = self._config:Get("CombatDistance") or 7
		local offset = (root.Position - targetRoot.Position)
		local flatOffset = Vector3.new(offset.X, 0, offset.Z)
		local targetPos = targetRoot.Position
			+ (if flatOffset.Magnitude > 0.1 then flatOffset.Unit * desiredDist else Vector3.new(0, 0, desiredDist))

		if (root.Position - targetPos).Magnitude > 4 then
			self._nav:NavigateTo(targetPos)
		end

		root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z))

		local now = os.clock()
		if now - self._lastAttackClock >= 0.35 then
			self._lastAttackClock = now
			local preHealth = targetHum.Health
			local method = self._config:Get("FightingMethod")
			local fired = self._adapter.RequestAttack(method, self._comboIndex)
			self._comboIndex = (self._comboIndex % 5) + 1

			if fired then
				task.delay(0.15, function()
					if targetHum and targetHum.Parent and targetHum.Health < preHealth then
						self.Stats.TotalHitsVerified += 1
						self.Stats.DamageDealtEstimate += (preHealth - targetHum.Health)
						if targetHum.Health <= 0 then
							self.Stats.TargetsDefeated += 1
						end
					end
				end)
			end
		end
	end

	return CombatService
end)()

