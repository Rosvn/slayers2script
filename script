Modules.Core = (function()
	export type ModuleStatus = "IDLE" | "RUNNING" | "RECOVERING" | "ERROR" | "MISSING_DEPENDENCY"

	export type IGameAdapter = {
		IsBound: boolean,
		GetNPCFolder: () -> Instance?,
		GetDropFolder: () -> Instance?,
		GetCacheFolder: () -> Instance?,
		RequestAttack: (weaponType: string, comboIndex: number) -> boolean,
		RequestSkill: (skillKey: Enum.KeyCode) -> boolean,
		RequestParry: () -> boolean,
		UseHealingItem: (itemName: string) -> boolean,
		RequestQuestStart: (questId: string) -> boolean,
		RequestQuestTurnIn: (questId: string) -> boolean,
		AllocateStatPoint: (statName: string, amount: number) -> boolean,
		SpinTrait: (category: "Clan" | "EvilArt") -> (boolean, string?),
		SelectTowerCard: (cardId: string) -> boolean,
		FlipCoin: (betAmount: number) -> (boolean, string?),
	}

	local DefaultGameAdapter: IGameAdapter = {
		IsBound = false,
		GetNPCFolder = function()
			return workspace:FindFirstChild("NPCs") or workspace:FindFirstChild("Mobs")
		end,
		GetDropFolder = function()
			return workspace:FindFirstChild("Drops") or workspace:FindFirstChild("Items")
		end,
		GetCacheFolder = function()
			return workspace:FindFirstChild("Caches") or workspace:FindFirstChild("Chests")
		end,
		RequestAttack = function(_weaponType: string, _comboIndex: number): boolean
			warn("[GameAdapter] Missing Combat Remote binding for RequestAttack")
			return false
		end,
		RequestSkill = function(_skillKey: Enum.KeyCode): boolean
			warn("[GameAdapter] Missing Skill Remote binding for RequestSkill")
			return false
		end,
		RequestParry = function(): boolean
			warn("[GameAdapter] Missing Parry Remote binding for RequestParry")
			return false
		end,
		UseHealingItem = function(_itemName: string): boolean
			return false
		end,
		RequestQuestStart = function(_questId: string): boolean
			return false
		end,
		RequestQuestTurnIn = function(_questId: string): boolean
			return false
		end,
		AllocateStatPoint = function(_statName: string, _amount: number): boolean
			return false
		end,
		SpinTrait = function(_category: "Clan" | "EvilArt"): (boolean, string?)
			return false, "Unbound Adapter"
		end,
		SelectTowerCard = function(_cardId: string): boolean
			return false
		end,
		FlipCoin = function(_betAmount: number): (boolean, string?)
			return false, "Unbound Adapter"
		end,
	}

	local EventBus = {}
	EventBus.__index = EventBus

	function EventBus.new()
		local self = setmetatable({}, EventBus)
		self._listeners = {} :: { [string]: { (...any) -> () } }
		return self
	end

	function EventBus:Subscribe(topic: string, callback: (...any) -> ())
		if not self._listeners[topic] then
			self._listeners[topic] = {}
		end
		table.insert(self._listeners[topic], callback)
	end

	function EventBus:Publish(topic: string, ...: any)
		local callbacks = self._listeners[topic]
		if not callbacks then return end
		for _, cb in ipairs(callbacks) do
			task.spawn(cb, ...)
		end
	end

	local ConfigManager = {}
	ConfigManager.__index = ConfigManager

	function ConfigManager.new(eventBus: any)
		local self = setmetatable({}, ConfigManager)
		self._bus = eventBus
		self.State = {
			CombatEnabled = false,
			KillAuraEnabled = false,
			AutoParry = false,
			InstantKillTest = false,
			FightingMethod = "Katana",
			CombatDistance = 7,
			RetreatHealthPct = 0.25,
			HealHealthPct = 0.50,
			AutoMobFarm = false,
			AutoBossFarm = false,
			AutoCacheCollect = false,
			AutoSoulCollect = false,
			TargetPriority = { "Muzan", "Yeti", "Boss", "Mob" },
			AutoQuest = false,
			SelectedQuestType = "BestAvailable",
			AutoTower = false,
			AutoDungeon = false,
			WalkSpeed = 16,
			JumpPower = 50,
			AlwaysRun = false,
			FlightEnabled = false,
			FlightSpeed = 60,
			NoClipEnabled = false,
			AntiVoidEnabled = true,
			AntiFlingEnabled = true,
			AutoCoinFlip = false,
			CoinFlipTarget = 100000,
		} :: { [string]: any }
		return self
	end

	function ConfigManager:Set(key: string, value: any)
		if self.State[key] ~= value then
			self.State[key] = value
			self._bus:Publish("ConfigChanged", key, value)
		end
	end

	function ConfigManager:Get(key: string): any
		return self.State[key]
	end

	function ConfigManager:ExportJSON(): string
		return HttpService:JSONEncode(self.State)
	end

	function ConfigManager:ImportJSON(jsonStr: string): boolean
		local success, decoded = pcall(function()
			return HttpService:JSONDecode(jsonStr)
		end)
		if success and type(decoded) == "table" then
			for k, v in pairs(decoded) do
				self:Set(k, v)
			end
			return true
		end
		return false
	end

	export type TaskEntry = {
		Name: string,
		Priority: number,
		Condition: () -> boolean,
		Execute: (dt: number) -> (),
		Status: ModuleStatus,
		LastError: string?,
	}

	local StateArbiter = {}
	StateArbiter.__index = StateArbiter

	function StateArbiter.new(eventBus: any)
		local self = setmetatable({}, StateArbiter)
		self._bus = eventBus
		self._tasks = {} :: { TaskEntry }
		self.ActiveTask = "NONE"
		return self
	end

	function StateArbiter:RegisterTask(taskEntry: TaskEntry)
		table.insert(self._tasks, taskEntry)
		table.sort(self._tasks, function(a, b)
			return a.Priority > b.Priority
		end)
	end

	function StateArbiter:Step(dt: number)
		for _, taskItem in ipairs(self._tasks) do
			local ok, shouldRun = pcall(taskItem.Condition)
			if ok and shouldRun then
				if self.ActiveTask ~= taskItem.Name then
					self.ActiveTask = taskItem.Name
					self._bus:Publish("ActiveTaskChanged", self.ActiveTask)
				end
				taskItem.Status = "RUNNING"
				local execOk, err = pcall(taskItem.Execute, dt)
				if not execOk then
					taskItem.Status = "ERROR"
					taskItem.LastError = tostring(err)
					self._bus:Publish("ModuleError", taskItem.Name, tostring(err))
				end
				return
			else
				taskItem.Status = "IDLE"
			end
		end
		if self.ActiveTask ~= "NONE" then
			self.ActiveTask = "NONE"
			self._bus:Publish("ActiveTaskChanged", "NONE")
		end
	end

	return {
		DefaultGameAdapter = DefaultGameAdapter,
		EventBus = EventBus,
		ConfigManager = ConfigManager,
		StateArbiter = StateArbiter,
	}
end)()

